%% 正式图源已迁移到 figure-4-5-core-er.drawio。
%% 原因：论文需要规范 Chen E-R 图，完整标注实体、联系、属性、PK/FK 与 1/N 基数；
%% Mermaid 版本仅保留为历史简化预览，不作为论文插图源。
flowchart LR
  U[普通用户]:::entity
  A[管理员]:::entity
  P[个人档案]:::entity
  RFP[风险因素档案]:::entity
  BP[血压记录]:::entity
  PM[Prophet模型元数据]:::entity
  PR[预测记录]:::entity

  R1{拥有}:::relation
  R2{维护}:::relation
  R3{记录}:::relation
  R4{训练/复用}:::relation
  R5{发起预测}:::relation
  R6{治理查看}:::relation

  U -- "1" --> R1
  R1 -- "1" --> P
  U -- "1" --> R2
  R2 -- "1" --> RFP
  U -- "1" --> R3
  R3 -- "N" --> BP
  U -- "1" --> R4
  R4 -- "N" --> PM
  U -- "1" --> R5
  R5 -- "N" --> PR
  BP -- "用于趋势预测" --> R5
  RFP -- "用于风险分类" --> R5
  PM -- "提供模型状态" --> R5
  A -- "1" --> R6
  R6 -- "N" --> PR

  U_ID([用户ID]):::attr --- U
  U_NAME([用户名/邮箱]):::attr --- U
  P_NICK([昵称/头像]):::attr --- P
  P_DIAG([诊断反馈]):::attr --- P
  R_AGE([年龄/性别]):::attr --- RFP
  R_BODY([身高/体重/BMI]):::attr --- RFP
  R_RISK([吸烟/用药/糖尿病]):::attr --- RFP
  R_LAB([胆固醇/血糖]):::attr --- RFP
  BP_SYS([收缩压]):::attr --- BP
  BP_DIA([舒张压]):::attr --- BP
  BP_TIME([记录时间]):::attr --- BP
  PM_VER([模型版本]):::attr --- PM
  PM_SIG([数据签名]):::attr --- PM
  PM_KEY([存储键]):::attr --- PM
  PR_PROB([风险概率]):::attr --- PR
  PR_LEVEL([风险等级]):::attr --- PR
  PR_SNAP([输入快照]):::attr --- PR
  PR_META([趋势/融合/建议载荷]):::attr --- PR
  A_ID([管理员ID]):::attr --- A
  A_AUTH([账号/权限]):::attr --- A

  classDef entity fill:#fff7ed,stroke:#9a3412,stroke-width:1.4px,color:#111827;
  classDef relation fill:#eef2ff,stroke:#4338ca,stroke-width:1.4px,color:#111827;
  classDef attr fill:#f8fafc,stroke:#64748b,stroke-width:1px,color:#111827;
