  E --> E2["置信度分布"]
  E --> E3["异常预测数量"]
  E --> E4["Prophet复用/重训次数"]

  C --> F["治理筛选列表"]
  D --> F
  F --> F1["按风险等级筛选"]
  F --> F2["按置信度筛选"]
  F --> F3["按异常类型筛选"]

  F --> G["单条预测详情"]
  G --> G1["输入快照"]
  G --> G2["融合元数据"]
