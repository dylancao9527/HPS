  <diagram id="图4-1 Prophet血压趋势预测流程" name="图4-1 Prophet血压趋势预测流程">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="A" value="普通用户录入血压记录&#xa;收缩压、舒张压、心率、测量时间" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;align=center;verticalAlign=middle;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="360" height="135" as="geometry"/></mxCell>
        <mxCell id="B" value="按自然日聚合&#xa;生成每日收缩压与舒张压均值" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;align=center;verticalAlign=middle;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="370" height="135" as="geometry"/></mxCell>
