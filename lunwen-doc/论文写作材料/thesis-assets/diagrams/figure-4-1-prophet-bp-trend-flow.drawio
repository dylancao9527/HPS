        <mxCell id="D" value="阻止7天风险预测&#xa;提示继续记录血压" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;align=center;verticalAlign=middle;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1320" y="140" width="380" height="135" as="geometry"/></mxCell>
        <mxCell id="E" value="构造 Prophet 训练上下文&#xa;最近90天窗口、数据签名、参数画像" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;align=center;verticalAlign=middle;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="390" height="150" as="geometry"/></mxCell>
