flowchart TD
  U["普通用户"] --> A["维护风险因素档案"]
  U --> B["持续记录血压数据"]

  A --> C{"预测前校验<br/>风险因素档案是否满足最低完整性"}
  B --> D{"预测前校验<br/>血压自然日是否满足最低要求"}
  C -- "不满足" --> C1["提示完善风险因素档案"]
  D -- "不满足" --> D1["提示继续记录血压"]
  C -- "满足" --> E["读取用户个人风险因素"]
  D -- "满足" --> F["生成每日血压序列"]

  F --> G["Prophet血压趋势预测<br/>未来7天收缩压与舒张压"]
  G --> H["预测期血压特征构建<br/>sysBP均值、diaBP均值"]
  E --> I["LightGBM风险分类"]
  H --> I
  I --> J["raw_probability"]
  G --> K["趋势摘要<br/>高血压天数、峰值、斜率、波动"]
  J --> L["趋势融合策略"]
  K --> L
  E --> L
  L --> M["fused_probability<br/>最终高血压风险概率"]
  M --> N["风险等级<br/>低 / 中 / 高"]
  M --> O["指南型健康建议<br/>依据2024年修订版指南"]
  G --> P["未来7天血压趋势图"]
  N --> Q["用户端预测摘要"]
  O --> Q
  P --> Q
  Q --> R["创建不可变预测记录"]
  R --> S["预测历史与预测结果治理"]
