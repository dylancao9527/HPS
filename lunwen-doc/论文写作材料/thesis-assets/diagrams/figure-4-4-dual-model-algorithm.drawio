          <mxGeometry x="50" y="142" width="210" height="78" as="geometry" />
        </mxCell>
        <mxCell id="risk" value="个人风险因素&#xa;年龄、性别、BMI、吸烟、用药等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="450" width="210" height="78" as="geometry" />
        </mxCell>
        <mxCell id="check" value="数据校验与日聚合&#xa;按自然日形成日均血压序列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b38b00;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="330" y="142" width="205" height="78" as="geometry" />
        </mxCell>
        <mxCell id="prophet" value="Prophet 趋势预测&#xa;生成未来 7 天 SBP / DBP 点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#5f8f5f;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="605" y="142" width="205" height="78" as="geometry" />
        </mxCell>
        <mxCell id="bpfeature" value="预测期血压特征&#xa;SBP_future、DBP_future" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#4b78a8;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="142" width="205" height="78" as="geometry" />
        </mxCell>
        <mxCell id="vector" value="LightGBM 输入向量&#xa;风险因素 + 预测期血压特征" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b38b00;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="605" y="450" width="205" height="78" as="geometry" />
        </mxCell>
        <mxCell id="lgbm" value="LightGBM 风险分类&#xa;输出原始风险概率 p_raw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="450" width="205" height="78" as="geometry" />
        </mxCell>
        <mxCell id="signals" value="趋势融合信号&#xa;高血压天数、峰值、斜率、用药状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#5a7fb0;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="278" width="205" height="86" as="geometry" />
        </mxCell>
        <mxCell id="fusion" value="受约束概率融合&#xa;p_raw + Δ_trend + Δ_med" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft YaHei;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1145" y="360" width="205" height="78" as="geometry" />
        </mxCell>
